#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/homebox

start_service() {
	local enabled host port

	config_load homebox
	config_get_bool enabled config enabled 0

	# The service is off by default and is only started on demand, so that the
	# router does not keep the test endpoint listening all the time.
	[ "$enabled" -eq 1 ] || return 0

	config_get host config host '0.0.0.0'
	config_get port config port '3300'

	procd_open_instance
	procd_set_param command "$PROG" serve --host "$host" --port "$port"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# a speed test opens a lot of parallel connections
	procd_set_param limits nofile="65535"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger homebox
}
